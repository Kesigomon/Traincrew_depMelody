<Window x:Class="Traincrew_depMelody.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traincrew depMelody" Height="700" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- シリアルポート設定パネル -->
        <GroupBox Grid.Row="0" Header="シリアルポート設定" Margin="4">
            <StackPanel Margin="4">
                <!-- ポート選択 + 更新ボタン -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="ポート:" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxPort" Width="90" VerticalAlignment="Center" />
                    <Button x:Name="ButtonRefreshPorts" Content="更新" Width="40"
                            Margin="4,0,0,0" Click="ButtonRefreshPorts_Click" />
                </StackPanel>

                <!-- 入力線選択 + 反転チェックボックス -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="入力線:" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboBoxPin" Width="60" VerticalAlignment="Center" />
                    <CheckBox x:Name="CheckBoxInverted" Content="反転" Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- 接続/切断ボタン + 状態ラベル -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Button x:Name="ButtonConnect" Content="接続" Width="50"
                            Click="ButtonConnect_Click" />
                    <Button x:Name="ButtonDisconnect" Content="切断" Width="50"
                            Margin="4,0,0,0" Click="ButtonDisconnect_Click" IsEnabled="False" />
                    <Label x:Name="LabelSerialStatus" Content="未接続"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ONボタン -->
        <Button x:Name="OnButton"
                Grid.Row="1"
                Content="ON"
                FontSize="72"
                Background="Black"
                Foreground="White"
                Click="OnButton_Click"
                IsEnabled="False" />

        <!-- OFFボタン -->
        <Button x:Name="OffButton"
                Grid.Row="2"
                Content="OFF"
                FontSize="72"
                Background="Red"
                Foreground="White"
                Click="OffButton_Click"
                IsEnabled="False" />
    </Grid>
</Window>
